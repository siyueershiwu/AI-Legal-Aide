# ========== Docker Compose 环境变量模板 ==========
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
#
# 此文件供 docker compose 使用（Redis + MinIO）。
# 后端应用读取 backend/.env，不读取此文件。

# ---- Redis ----
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=what

# ---- 以下仅 docker-compose.prod.yml 需要 ----
# (本地开发不需要)

# MySQL (生产环境中 backend 容器通过 host.docker.internal 访问宿主机)
MYSQL_ROOT_PASSWORD=change-me-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=whatdb

# Backend
SECRET_KEY=change-me-to-a-random-string-at-least-86-chars
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
BACKEND_PORT=8000
