# ===== App =====
APP_NAME=Chat API
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ===== Security =====
# 生产前必须改成强随机值: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 长度至少 32 字符（推荐 86+）。改完会让所有已签发的 JWT 失效，用户需重新登录。
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe_64
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_EXPIRE_SECONDS=604800

# ===== Database =====
# 容器内用 service 名 `mysql`；本地裸跑（不用 docker compose）改成 `localhost`
# 异步驱动格式: mysql+aiomysql://user:pass@host:port/db
# 密码必须与根目录 .env 里的 MYSQL_ROOT_PASSWORD 一致
DATABASE_URL=mysql+aiomysql://root:CHANGE_ME_db_password@mysql:3306/chat_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===== Redis =====
# 容器内用 service 名 `redis`；本地裸跑改成 `localhost`
# 格式: redis://[:password@]host:port/db
# 密码必须与根目录 .env 里的 REDIS_PASSWORD 一致
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0
REDIS_PASSWORD=CHANGE_ME_redis_password

# ===== MinIO / Object Storage =====
# 容器内用 service 名 `minio`；本地裸跑改成 `localhost`
# ACCESS_KEY / SECRET_KEY 必须与根目录 .env 里的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 一致
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min_16_chars
MINIO_BUCKET=chat-files
MINIO_SECURE=false
MAX_FILE_SIZE=10485760

# ===== Doubao (Volcengine Ark) =====
# 在 https://www.volcengine.com/product/ark 申请 API key
DOUBAO_API_KEY=CHANGE_ME_get_from_volcengine_ark
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== Rate limit =====
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
