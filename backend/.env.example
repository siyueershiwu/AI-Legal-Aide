# ========== 后端应用环境变量模板 ==========
# 复制此文件为 .env 并填入真实值：
#   cp .env.example .env
#
# MySQL 使用本地安装；Redis / MinIO 通过 Docker Compose 启动。

# ---- 应用 ----
APP_NAME=Chat API
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- 安全 ----
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string-at-least-86-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_EXPIRE_SECONDS=604800

# ---- MySQL (本地安装) ----
DATABASE_URL=mysql+aiomysql://root:change-me@localhost:3306/whatdb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis (Docker) ----
REDIS_URL=redis://:change-me@localhost:6379/0
REDIS_PASSWORD=change-me

# ---- MinIO (Docker) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=chat-files
MINIO_SECURE=false
MAX_FILE_SIZE=10485760

# ---- 豆包 API ----
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-2-0-pro-260215
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- 限流 ----
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ---- 第三方 API ----
# Tavily Search: https://tavily.com 注册获取 key
TAVILY_API_KEY=your-tavily-key
# 百度翻译: https://api.fanyi.baidu.com 注册获取 appid + secret
BAIDU_APPID=your-baidu-appid
BAIDU_SECRET=your-baidu-secret

# ---- RAG / Vector Store ----
# 首次启动自动从 HuggingFace 下载 ~100MB 模型到 EMBEDDING_CACHE_DIR。
# 离线环境先预热: python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-zh-v1.5', cache_folder='./models')"
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./models
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.45
