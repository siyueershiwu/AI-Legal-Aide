# Docker Compose 用的环境变量模板
# 用法：cp .env.example.docker .env，然后填入真实值
# 这份文件与 backend/.env 是两套不同的东西：
#   - 根 .env       →  docker compose 读，给容器编排用（数据库/对象存储的 root 密码）
#   - backend/.env  →  app 代码读，给后端应用用（SECRET_KEY / API URL / 业务密码）

# ===== MySQL =====
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(24))"
MYSQL_ROOT_PASSWORD=CHANGE_ME_MySQL_root_password_min_16_chars
MYSQL_DATABASE=chat_db

# ===== MinIO =====
# 不要使用默认 minioadmin。MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 必须与
# backend/.env 里的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY 保持一致。
MINIO_ROOT_USER=CHANGE_ME_MinIO_user
MINIO_ROOT_PASSWORD=CHANGE_ME_MinIO_password_min_16_chars

# ===== 豆包（一般不用改） =====
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
